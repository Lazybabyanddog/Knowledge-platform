# 复制为 .env 后按需修改：copy .env.example .env
# 该文件同时被 docker compose（变量替换）与后端 Settings 读取。

# ---------- 应用 ----------
APP_NAME=ai-platform
APP_ENV=local
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=ai_platform
# 5432 若被宿主已有 PostgreSQL 占用，用 5434 避开
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://ai_platform:ai_platform@localhost:5434/ai_platform
DB_ECHO=false

# ---------- Neo4j ----------
NEO4J_PASSWORD=ai_platform_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# ---------- MinIO ----------
MINIO_ROOT_USER=ai_platform
MINIO_ROOT_PASSWORD=ai_platform_minio
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=ai_platform
MINIO_SECRET_KEY=ai_platform_minio
MINIO_BUCKET=ai-platform
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRE_SECONDS=900

# ---------- Redis / Celery ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 认证 ----------
# HS256 密钥不短于 32 字节，生产环境必须替换
JWT_SECRET=dev-only-secret-change-me-in-production-01
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# ---------- 上传 ----------
UPLOAD_MAX_SIZE_MB=200

# ---------- 解析 ----------
PARSE_MAX_ATTEMPTS=3
PARSE_QUALITY_THRESHOLD=60
PARSE_BLOCK_RETENTION_DAYS=90

# ---------- 抽取 ----------
EXTRACT_MAX_REPAIR_ATTEMPTS=2
EXTRACT_BATCH_SIZE=8

# ---------- LLM ----------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# ---------- Embedding ----------
# 阿里云百炼的 OpenAI 兼容入口：https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空则索引任务跳过、问答接口返回 503，其余功能照常
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 必须与 document_chunk.embedding 列维度一致，改维度需要迁移并全量重建
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60

# ---------- 检索 ----------
RETRIEVAL_TOP_K=6
RETRIEVAL_OVERSAMPLE=4
RETRIEVAL_HNSW_EF_SEARCH=100
# 非管理员可见的最高密级：public / internal / confidential / secret
RETRIEVAL_MAX_SENSITIVITY=internal

# ---------- 种子数据 ----------
SEED_WORKSPACE_SLUG=default
SEED_WORKSPACE_NAME=默认空间
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_DISPLAY_NAME=系统管理员
