# 复制为 .env 后按需修改：copy .env.example .env
# 该文件同时被 docker compose（变量替换）与后端 Settings 读取。

# ---------- 应用 ----------
APP_NAME=ai-platform
APP_ENV=local
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=ai_platform
# 5432 若被宿主已有 PostgreSQL 占用，用 5434 避开
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://ai_platform:ai_platform@localhost:5434/ai_platform
DB_ECHO=false

# ---------- Neo4j ----------
NEO4J_PASSWORD=ai_platform_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# ---------- MinIO ----------
MINIO_ROOT_USER=ai_platform
MINIO_ROOT_PASSWORD=ai_platform_minio
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=ai_platform
MINIO_SECRET_KEY=ai_platform_minio
MINIO_BUCKET=ai-platform
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRE_SECONDS=900

# ---------- Redis / Celery ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 认证 ----------
# HS256 密钥不短于 32 字节，生产环境必须替换
JWT_SECRET=dev-only-secret-change-me-in-production-01
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# ---------- 上传 ----------
UPLOAD_MAX_SIZE_MB=200

# ---------- 解析 ----------
PARSE_QUALITY_THRESHOLD=60
PARSE_BLOCK_RETENTION_DAYS=90

# ---------- 抽取 ----------
EXTRACT_MAX_REPAIR_ATTEMPTS=2
EXTRACT_BATCH_SIZE=8

# ---------- 任务重试与恢复 ----------
# 预算分层：attempt 是执行序号；自动重试、降参、人工继续各自计数，互不侵占。
# 自动重试置 0 即回到"失败后只能人工继续"的行为。
TASK_AUTO_RETRY_MAX_ATTEMPTS=3
# 逗号分隔的退避秒数，超出长度沿用最后一个
TASK_AUTO_RETRY_BACKOFF_SECONDS=30,120,300
TASK_DOWNGRADE_MAX_ATTEMPTS=1
# 降参后的批大小 = 原批大小 * 比例，且不低于下限
TASK_DOWNGRADE_BATCH_RATIO=0.5
TASK_DOWNGRADE_BATCH_MIN=2
TASK_MANUAL_REVIVE_MAX_ATTEMPTS=2
TASK_SKIP_FAILED_BATCHES_ENABLED=true
# 看护：心跳过期判死；阈值必须明显大于心跳 TTL，否则在跑的任务会被误判
TASK_HEARTBEAT_TTL_SECONDS=120
TASK_STALE_THRESHOLD_SECONDS=300
TASK_WATCHDOG_ENABLED=true
TASK_WATCHDOG_INTERVAL_SECONDS=60

# ---------- 执行上限与锁 ----------
# 必须联动：hard > soft；锁 TTL 与 broker 可见性超时都要大于 hard，
# 否则会出现"锁先过期导致双执行"或"消息被提前重投"。
PARSE_SOFT_TIME_LIMIT_SECONDS=900
PARSE_HARD_TIME_LIMIT_SECONDS=960
EXTRACT_SOFT_TIME_LIMIT_SECONDS=3600
EXTRACT_HARD_TIME_LIMIT_SECONDS=3900
PARSE_RUN_LOCK_TTL_SECONDS=5400
EXTRACT_RUN_LOCK_TTL_SECONDS=5400
CELERY_VISIBILITY_TIMEOUT_SECONDS=5400

# ---------- LLM ----------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
# 进程内重试只消抖动（超时/429/5xx），失败到进程退出仍交给任务级自动重试
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=8.0
LLM_RETRY_JITTER_RATIO=0.25

# ---------- Embedding ----------
# 阿里云百炼的 OpenAI 兼容入口：https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空则索引任务跳过、问答接口返回 503，其余功能照常
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 必须与 document_chunk.embedding 列维度一致，改维度需要迁移并全量重建
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60

# ---------- 检索 ----------
RETRIEVAL_TOP_K=6
RETRIEVAL_OVERSAMPLE=4
RETRIEVAL_HNSW_EF_SEARCH=100
# 非管理员可见的最高密级：public / internal / confidential / secret
RETRIEVAL_MAX_SENSITIVITY=internal

# ---------- 种子数据 ----------
SEED_WORKSPACE_SLUG=default
SEED_WORKSPACE_NAME=默认空间
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_DISPLAY_NAME=系统管理员
